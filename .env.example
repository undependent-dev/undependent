# Undependent — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

# ── Database ──
DATABASE_PATH=data/undependent.db

# ── Server ──
SERVER_PORT=8080

# ── JWT Authentication ──
# Auto-generated if not set. Set explicitly for production.
# JWT_SECRET=your-random-secret-here

# ── Stripe (required for payments) ──
# 1. Create account at https://dashboard.stripe.com
# 2. Get API keys: https://dashboard.stripe.com/apikeys
#    - STRIPE_SECRET_KEY: your "Secret key" (sk_live_... or sk_test_...)
#    - STRIPE_WEBHOOK_SECRET: from webhook endpoint settings
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (required for scan results) ──
# Using SMTP:
SMTP_HOST=smtp.mailprovider.com
SMTP_PORT=587
SMTP_USER=your-email@mailprovider.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@undependent.dev

# ── GitHub App (required for GitHub integration) ──
# 1. Create a GitHub App: https://github.com/settings/apps/new
# 2. Configure permissions: Contents (read/write), Pull requests (read/write)
# 3. Generate a private key (PEM format)
# 4. Install the app on your repositories
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=