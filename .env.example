# Undependent — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

# ── Database ──
DATABASE_PATH=data/undependent.db

# ── Server ──
SERVER_PORT=8080

# ── Stripe (required for payments) ──
# 1. Create account at https://dashboard.stripe.com
# 2. Get API keys: https://dashboard.stripe.com/apikeys
#    - STRIPE_SECRET_KEY: your "Secret key" (sk_live_... or sk_test_...)
# 3. Create webhook: https://dashboard.stripe.com/webhooks
#    - Endpoint URL: https://undependent.dev/api/webhook/stripe
#    - Events: checkout.session.completed
#    - Copy the "Signing secret" (whsec_...) to STRIPE_WEBHOOK_SECRET
# 4. Create Payment Links: https://dashboard.stripe.com/payment-links
#    - Single Scan: $99 one-time payment → paste URL in website js/main.js STRIPE_LINKS.scan
#    - Commercial License: $299/year subscription → paste URL in website js/main.js STRIPE_LINKS.license
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Resend (required for email delivery) ──
# 1. Create account at https://resend.com
# 2. Create API key: https://resend.com/api-keys
# 3. Verify domain: https://resend.com/domains → add undependent.dev → follow DNS verification
# 4. Set FROM_EMAIL to match your verified sender
RESEND_API_KEY=re_...
FROM_EMAIL=Undependent <noreply@undependent.dev>
